    "paths": {
        "/v1/health": {
            "get": {
                "description": "Health Check for service",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Health Check"
                ],
                "summary": "Validates that service is up and running",
