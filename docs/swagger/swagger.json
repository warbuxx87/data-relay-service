                    }
                }
            }
        }
    },
    "definitions": {
        "responses.HealthCheckResponse": {
            "type": "object",
            "properties": {
                "authenticationErrors": {
                    "type": "integer"
                },
                "currentlyHealthy": {
                    "type": "boolean"
                },
                "databaseConnectionErrors": {
                    "type": "integer"
                }
            }
        }
    },
    "securityDefinitions": {
        "ApiKeyAuth": {
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
